# Copy to .env and fill in. Never commit .env.
# Nothing in this file is sent to the browser.

PORT=4000
NODE_ENV=development

# Where the client runs, used for the CORS allow-list and cookie settings.
CLIENT_URL=https://kannasiTunesmusic.com

# MongoDB stores metadata only — never audio files.
MONGODB_URI=mongodb://127.0.0.1:27017/jj-music

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# How long a signed-in session lasts.
SESSION_TTL_DAYS=30

# Set to false to close registration once your own account exists.
ALLOW_REGISTRATION=true

# --- Storage -----------------------------------------------------------------
# "local" writes to LOCAL_UPLOAD_DIR, which is served only through the
# authenticated streaming route. "s3" works with AWS S3, Cloudflare R2 or any
# other S3-compatible provider.
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Most S3-compatible providers other than AWS need this set to true.
S3_FORCE_PATH_STYLE=false
# Lifetime in seconds for signed URLs, when signed URLs are used at all.
S3_SIGNED_URL_TTL=300

# --- Uploads -----------------------------------------------------------------
MAX_UPLOAD_MB=100
