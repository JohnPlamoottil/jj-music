# Phase 1 runs the UI against an in-memory mock of the real REST API so the
# screens can be reviewed before the Express server exists.
# Set this to false in Phase 3 and the same client code talks to the real API.
VITE_USE_MOCK_API=true

# Where `vite dev` proxies /api during development.
VITE_DEV_API_TARGET=https://kannasiTunesmusic.com/api
